#!/bin/bash
#PBS -N refused_india_fig
#PBS -q workq
#PBS -l select=1:ncpus=2:ngpus=1:mem=8gb
#PBS -l walltime=00:20:00
#PBS -j oe
# Figure of the Indian hourly study.  Submit from the Forecast_Correction_India folder:  qsub -o logs/india_fig.out hpc/india_fig.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 OMP_NUM_THREADS=1 MPLBACKEND=Agg
source ../India_Grid_Study/hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
echo "india fig $(date -Iseconds) on $(hostname), job $PBS_JOBID"
python -u code/scripts/india/fig_india.py

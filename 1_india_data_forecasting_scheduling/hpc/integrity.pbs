#!/bin/bash
#PBS -N refused_integrity
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
# Re-run the integrity check on the H100: pre-registration hash, the 42 frozen files (with the rename record), the
# panel content hash, and a re-scoring of all 52 pre-registered checks from the stored results.
# Submit from the project folder:  qsub -o logs/pbs/refused_integrity.out hpc/integrity.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1
source hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
MIG=$(python run_all.py pick-mig) || { echo "no free MIG instance"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "integrity $(date -Iseconds) on $(hostname), job $PBS_JOBID, GPU $CUDA_VISIBLE_DEVICES"
REFUSED_PHASE=confirm REFUSED_CONFIRMATORY=1 python -u run_all.py stage --force c_integrity
echo "integrity finished rc=$? $(date -Iseconds)"

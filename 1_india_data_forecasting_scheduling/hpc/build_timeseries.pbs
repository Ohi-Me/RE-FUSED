#!/bin/bash
#PBS -N refused_b09_timeseries
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
# Build step 9: the 15-minute and hourly all-India series from the Daily PSP TimeSeries sheets.
# Submit from the project folder:  qsub -o logs/pbs/refused_b09_timeseries.out hpc/build_timeseries.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 REFUSED_NCPUS=8
source hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
MIG=$(python run_all.py pick-mig) || { echo "no free MIG instance"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "b09 $(date -Iseconds) on $(hostname), job $PBS_JOBID"
python -u codes/scripts/build/b09_psp_timeseries.py
echo "b09 finished rc=$? $(date -Iseconds)"

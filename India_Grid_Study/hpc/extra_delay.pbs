#!/bin/bash
#PBS -N refused_delay
#PBS -q cpuq
#PBS -l select=1:ncpus=8:ngpus=0:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
# Delay study (additional analysis, not pre-registered): publication delay as forecast horizon. CPU only.
# EXP=E1 (horizon curve, h = 1-14) or EXP=E2 (one source group instant at a time). Writes results/extra/delay/ only.
# Submit from the project folder:  qsub -v EXP=E1 -o logs/pbs/refused_delay_E1.out hpc/extra_delay.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 OMP_NUM_THREADS=6 REFUSED_THREADS=6 CUDA_VISIBLE_DEVICES=""
source hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
echo "delay $EXP $(date -Iseconds) on $(hostname), job $PBS_JOBID"
env REFUSED_PHASE=confirm REFUSED_CONFIRMATORY=1 python -u codes/scripts/extra/x13_delay_experiments.py "$EXP"
echo "delay $EXP finished rc=$? $(date -Iseconds)"

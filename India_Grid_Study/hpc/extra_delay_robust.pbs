#!/bin/bash
#PBS -N refused_delay_robust
#PBS -q cpuq
#PBS -l select=1:ncpus=4:ngpus=0:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
# Delay study (additional analysis, not pre-registered): E4a robustness of the delay-horizon law from the stored
# E1 predictions (pinball loss, coverage, seasons). CPU only, no model fitted. Writes results/extra/delay/E4/ only.
# Submit from the project folder:  qsub -o logs/pbs/refused_delay_robust.out hpc/extra_delay_robust.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 OMP_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=""
source hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
echo "delay robust $(date -Iseconds) on $(hostname), job $PBS_JOBID"
python -u codes/scripts/extra/x16_delay_robustness.py
echo "delay robust finished rc=$? $(date -Iseconds)"

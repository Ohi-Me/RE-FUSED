#!/bin/bash
#PBS -N refused_fusion_tpwrs
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
# Settlement-aware fusion scheduler (protocol codes/design/09_fusion_tpwrs_protocol.md). PHASE=dev or confirm.
# Submit from the project folder:  qsub -v PHASE=dev -o logs/pbs/refused_fusion_tpwrs_dev.out hpc/extra_fusion_tpwrs.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 OMP_NUM_THREADS=6
source hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
MIG=$(python run_all.py pick-mig) || { echo "no free MIG instance"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "fusion tpwrs $PHASE $(date -Iseconds) on $(hostname), job $PBS_JOBID, GPU $CUDA_VISIBLE_DEVICES"
if [ "$PHASE" = "confirm" ]; then EXTRA="REFUSED_CONFIRMATORY=1"; else EXTRA=""; fi
env REFUSED_PHASE=$PHASE $EXTRA python -u codes/scripts/extra/x07_fusion_scheduler.py
echo "fusion tpwrs finished rc=$? $(date -Iseconds)"

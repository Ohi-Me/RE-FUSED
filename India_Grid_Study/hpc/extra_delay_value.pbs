#!/bin/bash
#PBS -N refused_delay_value
#PBS -q cpuq
#PBS -l select=1:ncpus=8:ngpus=0:mem=32gb
#PBS -l walltime=06:00:00
#PBS -j oe
# Delay study (additional analysis, not pre-registered): settlement value of timely publication, rules P and A2
# only (no GPU). Run after the E2 job:  qsub -W depend=afterok:<E2 job id> -o logs/pbs/refused_delay_value.out hpc/extra_delay_value.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 OMP_NUM_THREADS=8 CUDA_VISIBLE_DEVICES=""
source hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
echo "delay value $(date -Iseconds) on $(hostname), job $PBS_JOBID"
env REFUSED_PHASE=confirm REFUSED_CONFIRMATORY=1 python -u codes/scripts/extra/x14_value_of_timeliness.py
echo "delay value finished rc=$? $(date -Iseconds)"

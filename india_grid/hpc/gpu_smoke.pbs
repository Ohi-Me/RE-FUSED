#!/bin/bash
#PBS -N refused_gpu_smoke
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /Data3/<hpc-user>/RE-FUSED/logs/pbs/refused_gpu_smoke.out
cd /Data3/<hpc-user>/RE-FUSED
export PYTHONNOUSERSITE=1
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate refused_h100
MIG=$(python run_all.py pick-mig) || { echo "no free MIG instance"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "job $PBS_JOBID on $(hostname); CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
python -u hpc/gpu_smoke.py

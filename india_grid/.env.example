# RE-FUSED settings. Copy to .env and edit. run_all.py reads only the non-secret keys below;
# it uses SSH key authentication and never reads, stores or sends a password.
HPC_USER=your_username
HPC_HOST=<hpc-host>
HPC_DIR=/Data3/your_username/RE-FUSED
HPC_CONDA_ENV=refused_h100
HPC_CONDA_SH=/apps/compilers/anaconda3/etc/profile.d/conda.sh
HPC_GPU_NCPUS=16
HPC_CPU_NCPUS=16
HPC_WALLTIME=24:00:00
# optional: a fixed MIG instance UUID from 'nvidia-smi -L' (empty = pick a free one at job start)
REFUSED_MIG_UUID=

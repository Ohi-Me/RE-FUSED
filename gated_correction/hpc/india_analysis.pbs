#!/bin/bash
#PBS -N refused_india_analysis
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
# The pre-registered analysis of the Indian hourly study (qsub -v MAP=dev for the dry run, MAP=confirm after
# unblinding; REFUSED_INDIA_CONFIRMATORY=1 is needed for confirm).
# Submit from the gated_correction folder:  qsub -o 12_logs/india_analysis.out hpc/india_dev.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 REFUSED_THREADS=8 PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1 MPLBACKEND=Agg
source ../india_grid/hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
export HF_HOME=$(readlink -f ../india_grid)/data/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
MIG=$(cd ../india_grid && python run_all.py pick-mig) || { echo "no free MIG instance"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "india analysis $(date -Iseconds) on $(hostname), job $PBS_JOBID, GPU $CUDA_VISIBLE_DEVICES"
python -u 04_code/scripts/india/analyze_india.py --map ${MAP:-dev}

echo "india analysis finished rc=$? $(date -Iseconds)"

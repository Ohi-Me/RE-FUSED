#!/bin/bash
#PBS -N refused_india_dev
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=12:00:00
#PBS -j oe
# Development on Indian data: learned day-ahead forecasts for the all-India hourly series (development split, which
# never reads data from 1 March 2026 on), then the hourly adaptivity ladders on that split.
# Submit from the 2_forecast_correction_india folder:  qsub -o 12_logs/india_dev.out hpc/india_dev.pbs
cd "$PBS_O_WORKDIR"
export PYTHONNOUSERSITE=1 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 REFUSED_THREADS=8 PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1 MPLBACKEND=Agg
source ../1_india_data_forecasting_scheduling/hpc/cluster.env 2>/dev/null
source "${HPC_CONDA_SH:-/apps/compilers/anaconda3/etc/profile.d/conda.sh}"
conda activate "${HPC_CONDA_ENV:-refused_h100}"
export HF_HOME=$(readlink -f ../1_india_data_forecasting_scheduling)/data/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
MIG=$(cd ../1_india_data_forecasting_scheduling && python run_all.py pick-mig) || { echo "no free MIG instance"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "india dev $(date -Iseconds) on $(hostname), job $PBS_JOBID, GPU $CUDA_VISIBLE_DEVICES"
python -u 04_code/scripts/dev/make_learned_baselines_india.py --mode dev || exit 1
python -u 04_code/scripts/india/run_india_ladders.py --mode dev
echo "india dev finished rc=$? $(date -Iseconds)"
